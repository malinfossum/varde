# Auto-detect text files, normalize to LF in the repo and check them out as LF on every
# platform, so the format check sees the same bytes on Windows and on the Linux CI runner
* text=auto eol=lf

# Windows batch scripts must use CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Shell scripts must use LF
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
