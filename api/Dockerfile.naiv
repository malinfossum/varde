# Single stage, for the size comparison only. Ships the SDK and the source to production.
FROM mcr.microsoft.com/dotnet/sdk:10.0
WORKDIR /src
COPY . .
RUN dotnet publish Varde.Api/Varde.Api.csproj -c Release -o /app/publish
ENV ASPNETCORE_URLS=http://0.0.0.0:8080
CMD ["dotnet", "/app/publish/Varde.Api.dll"]
