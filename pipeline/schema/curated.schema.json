{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string"
		},
		"kommune": {
			"type": "string",
			"pattern": "^\\d{4}$"
		},
		"name": {
			"type": "string",
			"pattern": "\\S"
		},
		"units": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"unitId": {
						"type": "string",
						"pattern": "^(?:org:\\d{9}|adr:[^:\\s]+:[a-z0-9-]+)$"
					},
					"name": {
						"type": "string",
						"pattern": "\\S"
					},
					"include": {
						"type": "boolean"
					},
					"excludeReason": {
						"type": "string",
						"pattern": "\\S"
					},
					"sources": {
						"type": "object",
						"properties": {
							"orgNumber": {
								"type": "string",
								"pattern": "^\\d{9}$"
							},
							"navOfficeId": {
								"type": "string",
								"pattern": "\\S"
							},
							"pages": {
								"type": "array",
								"items": {
									"type": "string",
									"format": "uri"
								}
							}
						},
						"required": [
							"pages"
						],
						"additionalProperties": false
					},
					"categories": {
						"type": "array",
						"items": {
							"type": "string",
							"enum": [
								"okonomi",
								"bolig",
								"psykisk-helse",
								"rus",
								"vold-og-overgrep",
								"familie-og-barn",
								"arbeid",
								"juridisk-hjelp",
								"nodtjenester",
								"lavterskeltilbud"
							]
						}
					},
					"providerType": {
						"type": "string",
						"enum": [
							"offentlig",
							"frivillig"
						]
					},
					"lowThreshold": {
						"type": "object",
						"properties": {
							"value": {
								"type": "boolean"
							},
							"quotes": {
								"minItems": 1,
								"type": "array",
								"items": {
									"type": "string",
									"maxLength": 400,
									"pattern": "\\S"
								}
							},
							"decidedBy": {
								"type": "string",
								"enum": [
									"rule",
									"me"
								]
							}
						},
						"required": [
							"value",
							"quotes",
							"decidedBy"
						],
						"additionalProperties": false
					},
					"description": {
						"type": "object",
						"properties": {
							"nb": {
								"type": "string",
								"pattern": "\\S"
							},
							"en": {
								"type": "string",
								"pattern": "\\S"
							},
							"source": {
								"type": "string",
								"enum": [
									"ai",
									"human"
								]
							}
						},
						"required": [
							"nb",
							"en",
							"source"
						],
						"additionalProperties": false
					},
					"decisions": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"field": {
									"type": "string",
									"enum": [
										"name",
										"phone",
										"phoneHours",
										"address",
										"email",
										"website",
										"chatUrl",
										"openingHours",
										"cost",
										"costNote",
										"alwaysOpen",
										"lowThreshold"
									]
								},
								"value": {
									"anyOf": [
										{
											"type": "string",
											"pattern": "\\S"
										},
										{
											"type": "boolean"
										}
									]
								},
								"sourceUrl": {
									"type": "string",
									"format": "uri"
								},
								"decision": {
									"type": "string",
									"enum": [
										"accept",
										"reject"
									]
								},
								"decidedOn": {
									"type": "string",
									"format": "date",
									"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
								},
								"note": {
									"type": "string",
									"pattern": "\\S"
								}
							},
							"required": [
								"field",
								"value",
								"sourceUrl",
								"decision",
								"decidedOn"
							],
							"additionalProperties": false
						}
					},
					"recheckAfter": {
						"type": "string",
						"format": "date",
						"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
					}
				},
				"required": [
					"unitId",
					"name",
					"include",
					"sources",
					"categories",
					"providerType",
					"decisions"
				],
				"additionalProperties": false
			}
		}
	},
	"required": [
		"kommune",
		"name",
		"units"
	],
	"additionalProperties": false
}
