{
	"name": "varde-pipeline",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"schema": "node src/cli/export-schema.ts",
		"data:check": "node src/cli/data-check.ts",
		"key:freeze": "node src/cli/freeze-key.ts",
		"discover": "node src/cli/discover.ts",
		"fetch": "node src/cli/fetch.ts",
		"recall-report": "node src/cli/recall-report.ts"
	},
	"dependencies": {
		"cheerio": "1.2.0",
		"tldts": "7.4.19",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@types/node": "26.6.6",
		"typescript": "7.0.2",
		"vitest": "5.0.5"
	}
}
