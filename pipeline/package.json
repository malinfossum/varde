{
	"name": "varde-pipeline",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
