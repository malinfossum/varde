# Copy to .env and fill in real values: cp .env.example .env
# .env stays out of Git; this file is the contract for which variables the stack needs.

POSTGRES_DB=varde
POSTGRES_USER=varde
POSTGRES_PASSWORD=change-me

# Prod-sim (compose.prod.yml): the image name without tag, and the tag to deploy.
# Set IMAGE_TAG to a sha-tag from a green pipeline; the old tag is the way back.
API_IMAGE=ghcr.io/malinfossum/varde
IMAGE_TAG=latest
